                <apex:tab id="tabSpareParts" label="Spare Parts" name="Spare Parts">
                    <apex:pageBlock title="{!$Label.SparePartsUsed}" id="pbSpareParts">
                        <apex:pageBlockButtons location="top">
                            <!-- Below "NEW" button for SpareParts visible only in Classic version : added on 04-01-2022 by Adi-->
                            <apex:commandButton value="{!$Label.New}" rendered="{! (createMode || editMode) && NOT(IF(contains($CurrentPage.URL, 'lightning.force.com'), True, False))}" onclick="openLookupCustom('{!$Component.sparePartProductSearchlinkId}'); return false;"/>                          
                            <!-- Below "NEW" button for SpareParts visible only in Lightning Experience : added on 04-01-2022 by Adi -->  
                            <apex:commandButton id="SparePartSearchId" rendered="{!(createMode || editMode) && IF(contains($CurrentPage.URL, 'lightning.force.com'), True, False)}" value="{!$Label.New}" title="Search SparePart"
                                                onclick="openSparePartLookup(); return false;"/>
                        </apex:pageBlockButtons>
                        <apex:outputLink id="sparePartProductSearchlinkId" value="{!URLFOR($Page.CaseProductLookup)}" target="{!$Component.tabSpareParts}" title="Search Product"
                                         onclick="openLookupCustom('{!$Component.sparePartProductSearchlinkId}')">
                            <apex:param name="lookupType" value="{! sparePartLookupType}"/>
                        </apex:outputLink>
                        <apex:pageBlockTable rendered="{! spareParts != null && spareParts.size > 0}" id="sparePartsTable" value="{! spareParts}" var="sparePart" columnsWidth="100px">
                            <apex:column headerValue="Action" rendered="{! createMode || editMode}">
                                <div align="center">
                                    <!-- Below "DELETE" link for SpareParts visible only in Classic version : added on 04-01-2022 by Adi -->
                                    <apex:outputLink value="{!$Label.Del}" rendered="{!NOT(IF(contains($CurrentPage.URL, 'lightning.force.com'), True, False))}" onclick="removeSparePart('{! sparePart.Product__r.Id}'); return false;">{!$Label.Del}
                                    </apex:outputLink>
                                    <!-- Below "DELETE" link for SpareParts visible only in Lightning Experience : added on 04-01-2022 by Adi --> 
                                    <apex:commandLink value="{!$Label.Del}" rendered="{!IF(contains($CurrentPage.URL, 'lightning.force.com'), True, False)}" onclick="removeSparePart('{! sparePart.Product__r.Id}'); return false;" reRender="dummy"/>
                                </div>
                            </apex:column>
                            <apex:column value="{! sparePart.Product__r.ProductCode}" />
                            <apex:column value="{! sparePart.Product__c}" />
                            <apex:column value="{! sparePart.Product__r.Product_Type__c}" />
                            <apex:column value="{! sparePart.Product__r.Life_Threatening__c}" />
                            <!-- Below lot Number and serial number required based on serialized : added as part of EUTSV -1762 story by Uga-->
                            <!--Changes by Anusha to accomodate Old Raw SN# and New Raw SN# changes -EUTSV-3875- Start-->
                            <apex:column headerValue="Serial Number Details" headerClass="centerCol">
                                
                                <apex:pageBlockTable id="serialsparePartsTable" value="{!serialNum}" var="serialNumber" columnsWidth="125px"  styleClass="whiteHeader">
                                    
                                    <apex:column headerValue="{!$ObjectType.Spare_Part__c.Fields.Control_Number__c.Label}" style="width:33.33%;">
                                        <apex:outputPanel layout="block" styleClass="requiredInput">
                                            <apex:outputPanel layout="block" styleClass="requiredBlock" rendered="{! sparePart.Product__r.Product_Type__c =='Serial'}"/>   
                                            <apex:inputField rendered="{! createMode || editMode}" value="{! sparePart.Control_Number__c}" style="width:90%;"/>
                                        </apex:outputPanel>
                                        <apex:outputField rendered="{! NOT createMode && NOT editMode}" value="{! sparePart.Control_Number__c}" style="width:33.3px;"/>
                                    </apex:column>
                                    
                                    <apex:column headerValue="{!$ObjectType.Spare_Part__c.Fields.Old_Raw_Serial_Number__c.Label}" style="width:33.33%;">
                                        <apex:outputPanel layout="block" styleClass="requiredInput">
                                            <apex:outputPanel layout="block" rendered="{! sparePart.Product__r.Product_Type__c =='Serial'}"/>   
                                            <apex:inputField rendered="{! createMode || editMode}" value="{! sparePart.Old_Raw_Serial_Number__c}" style="width:90%;"/>
                                        </apex:outputPanel>
                                        <apex:outputField rendered="{! NOT createMode && NOT editMode}" value="{! sparePart.Old_Raw_Serial_Number__c}" style="width:100%;"/>
                                    </apex:column>
                                    
                                    <apex:column headerValue="{!$ObjectType.Spare_Part__c.Fields.New_Raw_Serial_Number__c.Label}" style="width:33.33%;">
                                        <apex:outputPanel layout="block" styleClass="requiredInput">
                                            <apex:outputPanel layout="block" rendered="{! sparePart.Product__r.Product_Type__c =='Serial'}"/>   
                                            <apex:inputField rendered="{! createMode || editMode}" value="{! sparePart.New_Raw_Serial_Number__c}" style="width:90%;"/>
                                        </apex:outputPanel>
                                        <apex:outputField rendered="{! NOT createMode && NOT editMode}" value="{! sparePart.New_Raw_Serial_Number__c}" style="width:100%;"/>
                                    </apex:column>
                                    
                                </apex:pageBlockTable>
                                
                            </apex:column>
                            <!--Changes by Anusha to accomodate Old Raw SN# and New Raw SN# changes -EUTSV-3875  End-->
                            <apex:column headerValue="{!$ObjectType.Spare_Part__c.Fields.Lot_Number__c.Label}">
                                <apex:outputPanel layout="block" styleClass="requiredInput">
                                    <apex:outputPanel layout="block" styleClass="requiredBlock" rendered="{!sparePart.Product__r.Product_Type__c =='Lot'}"/>
                                    
                                    <apex:inputField rendered="{!  createMode ||  editMode}" value="{! sparePart.Lot_Number__c}"/>
                                </apex:outputPanel>
                                <apex:outputField rendered="{! NOT createMode && NOT editMode}" value="{! sparePart.Lot_Number__c}"/>
                            </apex:column>
                            <apex:column headerValue="{!$ObjectType.Spare_Part__c.Fields.GTS_Warranty_Status__c.Label}" > 
                                <apex:outputPanel layout="block" styleClass="requiredBlock">
                                    <apex:inputField rendered="{! createMode ||  editMode}" value="{! sparePart.GTS_Warranty_Status__c}" required="true"/>
                                </apex:outputPanel>
                                <apex:outputField rendered="{! NOT createMode && NOT editMode}" value="{! sparePart.GTS_Warranty_Status__c}"/>
                            </apex:column>
                            
                            <apex:column headerValue="{!$ObjectType.Sotware_Version__c.Label}">
                                <apex:selectList value="{! sparePart.Software_Version__c}" size="1"
                                                 required="true" rendered="{! (createMode || editMode) && renderSoftwareVersionForProduct[sparePart.Product__c]}">
                                    <apex:selectOptions value="{! productIdToSoftwareVersionOptions[sparePart.Product__c]}" />
                                </apex:selectList>
                                <apex:outputField rendered="{! NOT createMode && NOT editMode}" value="{! sparePart.Software_Version__c}"/>
                            </apex:column>
                        </apex:pageBlockTable>
                    </apex:pageBlock>
                </apex:tab>
                <apex:tab id="tabQuestions" label="Questions" name="Questions" ontabenter="questionsLookedAt();">
                    <apex:pageBlock title="Questions" id="pbQuestions">
                        <apex:outputPanel id="noQuestionsPanel" rendered="{! not questionsToAsk}">
                            <p><apex:outputText value="{!$Label.NoQuestionsForCase}"/></p>
                        </apex:outputPanel>
                        <apex:outputPanel id="questionsPanel" rendered="{! questionsToAsk}">
                            <apex:repeat value="{!questions}" var="q" id="capeQA">
                                <p>
                                    <apex:outputText value="{!q.Number__c}. {!q.Text__c}"/>
                                    <input type="hidden" class="questionId" value="{!q.Id}"/>
                                </p>
                                <p>
                                    <input type="hidden" class="responseId" value="{!responses[q.Number__c-1].Id}"/>
                                    <apex:inputField rendered="{! (createMode || editMode) && ( (q.Number__c-1) < responses.size)}" styleClass="textClass responseInput" value="{!responses[q.Number__c-1].Response__c}"/>
                                    <apex:outputText rendered="{! (NOT createMode && NOT editMode) && ( (q.Number__c-1) < responses.size)}" value="{!responses[q.Number__c-1].Response__c}"/>
                                </p>
                            </apex:repeat>
                        </apex:outputPanel>
                    </apex:pageBlock>
                </apex:tab>
            </apex:tabPanel>
        </apex:pageBlock>
    </apex:form>
    <apex:pageBlock rendered="{! not createMode}">
        <apex:relatedList subject="{! Case}" list="CombinedAttachments"/>
    </apex:pageBlock>
</apex:page>