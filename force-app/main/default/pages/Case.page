    <script type="text/javascript">
    var productJsonData = {! jsonString};
    
    function populatePicklists(familyValue, modelValue)
    {
        console.log('populate picklists called');
        var families = Object.keys(productJsonData);
        families.sort();
        var familyPicklist = document.querySelector('.product-family-picklist');//EUTSV-3344,SAVE Disable and family picklist issue
        while (familyPicklist.firstChild)
        {
            familyPicklist.removeChild(familyPicklist.firstChild);
        }
        for(var i = 0; i < families.length; i++)
        {
            var opt = document.createElement('option');
            if(familyValue === undefined && i == 0)
            {
                opt.selected = true;
            }
            else if(familyValue !== undefined && families[i] === familyValue)
            {
                opt.selected = true;
            }
            opt.value = families[i];
            opt.innerHTML = families[i];
            familyPicklist.appendChild(opt);
        }
        // $('#familyJSPicklistId').css('display', 'inline');
        updateModelPicklist(modelValue);
    }
    function updateModelPicklist(modelValue)
    {
        if(modelValue == 'WIPE_PRODUCT_ID')
        {
            wipeProduct();
        }
        var modelPicklist = document.querySelector('.product-model-picklist');//EUTSV-3344,SAVE Disable and family picklist issue
        var familyPicklist = document.querySelector('.product-family-picklist');//EUTSV-3344,SAVE Disable and family picklist issue
        var models = productJsonData[familyPicklist.options[familyPicklist.selectedIndex].value];
        while (modelPicklist.firstChild)
        {
            modelPicklist.removeChild(modelPicklist.firstChild);
        }
        //EUTSV-3344,SAVE Disable and family picklist issue
        if(models.length === 0){
            var opt = document.createElement('option');
            opt.selected = true;
            opt.value = '';
            opt.innerHTML = '';
            modelPicklist.appendChild(opt);
        }//EUTSV-3344,SAVE Disable and family picklist issue
        for(var i = 0; i < models.length; i++)
        {
            var opt = document.createElement('option');
            if(modelValue === undefined && i == 0)
            {
                opt.selected = true;
            }
            else if(modelValue !== undefined && models[i] === modelValue)
            {
                opt.selected = true;
            }
            opt.value = models[i];
            opt.innerHTML = models[i];
            modelPicklist.appendChild(opt);
        }
    }
    var previousOnload = window.onload; window.onload = function() { if (previousOnload) { previousOnload(); } populatePicklists(undefined, undefined); }
    
    // Handle to lookup window object
    var winObjRef;
    // Lookup window features definition
    var strWinFeatures = "width=900,height=600,dependent=1,dialog=1,scrollbars=1,modal=1,alwaysRaised=1,location=0";
    var __top = (screen.height - 600)/2; // get the size
    var __left = (screen.width - 900)/2;
    strWinFeatures = strWinFeatures + "," + "top=" + __top + "," + "left=" + __left;
    
    // Function to call when lookup page is needed
    function openLookupCustom(srcComponent)
    {
        var URL = rebuildURL(srcComponent);
        console.log('srcComponent :'  +srcComponent);
        console.log('URL :'  +URL);
        
        if (winObjRef == null || winObjRef.closed) {
            winObjRef = window.open(URL, '', strWinFeatures);
        }
        console.log('winObjRef :' +winObjRef);
        winObjRef.focus();
    }
    function openProductLookup()
    {
        console.log('open pop up ');
        if(winObjRef !== undefined)
        {
            winObjRef.close();
            winObjRef = undefined;
        }
        var familyPicklist = document.querySelector('.product-family-picklist');//EUTSV-3344,SAVE Disable and family picklist issue
        console.log('familyPicklist '+familyPicklist);
        var familyValue = familyPicklist.options[familyPicklist.selectedIndex].value;
        console.log('familyValue '+familyValue);
        if(familyValue === '--None--')
        {
            familyValue = '';
        }
        var modelPicklist = document.querySelector('.product-model-picklist');//EUTSV-3344,SAVE Disable and family picklist issue
        console.log('modelPicklist'+modelPicklist);
        var modelValue = modelPicklist.options[modelPicklist.selectedIndex].value;
        console.log('modelValue'+modelValue);
        if(modelValue == '--Select a family--')
        {
            modelValue = '';
        }
        var popupUrl = '{!URLFOR($Page.CaseProductLookup)}?lookupType={! productLookupType}&productFamily=' + familyValue +'&productModel=' + modelValue;
        winObjRef = window.open(popupUrl, '', strWinFeatures, true);
        winObjRef.focus();
    }
    
    
    // Function to call when spareParts lookup page is needed : added on 04-01-2022 by Adi
    function openSparePartLookup()
    {
        var popupUrl = '{!URLFOR($Page.CaseProductLookup)}?lookupType={! sparePartLookupType}';
        winObjRef = window.open(popupUrl, '', strWinFeatures, true);
        winObjRef.focus();
    }
    function problemCodeSelectedJS(srcComponent)
    {
        var obj = document.getElementById(srcComponent);
        problemCodeSelected(obj.options[obj.selectedIndex].value);
    }
    function rebuildURL (srcComponent)
    {
        var obj = document.getElementById(srcComponent);
        console.log('obj before :' +obj); 
        return obj;
    }
    function updateProductFromProductCodeJS(srcComponent)
    {
        console.log('update product code from product js');
        var obj = document.getElementById(srcComponent);
        updateProductFromProductCode(obj.value);
    }
    function returnProductCodeFromLookup(lookupType, productId, productCode, family, model)
    {
        // Dispatch to correct apex controller methods
        console.log('lookupType : '+lookupType);
        console.log('productId : '+productId);
        winObjRef.close();
        if(lookupType == '{! sparePartLookupType}')
        {
            console.log('lookupType : '+lookupType);
            console.log('productId : '+productId);
            updateSpareParts(productId);
            
        }
        else if(lookupType =='{! productLookupType}')
        {
            console.log('lookupType : '+lookupType);
            console.log('productId : '+productId);
            updateProduct(productId, productCode);
            populatePicklists(family, model);
        }
    }
    function updateProductFromProductCodeCallback(selectedFamily, selectedModel)
    {
        populatePicklists(selectedFamily, selectedModel);
    }
    function fetchQuestionAndResponse() {
        //EUTSV-3344,SAVE Disable and family picklist issue(uncommented by swathi)
        var saveButton = document.querySelector("input[id$='saveBtn']");
            if (saveButton) {
                console.log("Save Button Element123:", saveButton);
                saveButton.disabled = true;
                saveButton.style.opacity = 0.5; // optional: visually dim
                saveButton.style.pointerEvents = 'none'; // ensures it's not clickable
            }//EUTSV-3344,SAVE Disable and family picklist issue
        
        var questionResponseMap = {};
        
        var questionIds = document.querySelectorAll('.questionId');
        var responseIds = document.querySelectorAll('.responseId');
        var responses = document.querySelectorAll('.responseInput');
        
        for (var i = 0; i < questionIds.length; i++) {
            var questionId = questionIds[i].value;
            var responseId = responseIds[i].value || null;
            var responseText = responses[i].value;
            questionResponseMap[questionId] = {
                responseId: responseId,
                responseValue: responseText
            };
        }
        console.log('Collected Data:', JSON.stringify(questionResponseMap));
        
        sendToApex(JSON.stringify(questionResponseMap));
    }
    </script>
    <apex:sectionHeader subtitle="New {!$ObjectType.Case.Label}" title="{!$ObjectType.Case.Label} {!$Label.Edit}" rendered="{! createMode}"/>
    <apex:sectionHeader subtitle="{! Case.CaseNumber}" title="{!$ObjectType.Case.Label}" rendered="{!not createMode}"/>
    
    <!-- Below "OutputPanel(printPanelIdClassic)" visible only in Classic version : added on 04-01-2022 by Adi -->
    <apex:outputPanel id="printPanelIdClassic" rendered="{!not createMode && NOT(IF(contains($CurrentPage.URL, 'lightning.force.com'), True, False))}">
        <apex:outputLink target="_blank" styleClass="fakePrintViewClass" value="{! URLFOR($Page.CaseReport)}?id={!Case.Id}&developerName={!$UserRole.DeveloperName}&reportType=QUOTE">Print Quote</apex:outputLink>
        <apex:outputText >&nbsp;|&nbsp;</apex:outputText>
        <apex:outputLink target="_blank" styleClass="fakePrintViewClass" value="{! URLFOR($Page.CaseReport)}?id={!Case.Id}&developerName={!$UserRole.DeveloperName}&reportType=REPAIR">Print Summary</apex:outputLink>
        <br/>
        <br/>
    </apex:outputPanel>
    
    <!-- Below "OutputPanel(printPanelIdLtng)" visible only in Lightning version : added on 04-01-2022 by Adi -->
    <apex:outputPanel id="printPanelIdLtng" rendered="{!not createMode && IF(contains($CurrentPage.URL, 'lightning.force.com'), True, False)}">
        <apex:outputLink target="_blank" styleClass="fakePrintViewClass" value="{!URLFOR($Page.CaseReport, null, [Id=Case.Id])}&developerName={!$UserRole.DeveloperName}&reportType=QUOTE">Print Quote</apex:outputLink>        
        <apex:outputText >&nbsp;|&nbsp;</apex:outputText>
        <apex:outputLink target="_blank" styleClass="fakePrintViewClass" value="{!URLFOR($Page.CaseReport, null, [Id=Case.Id])}&developerName={!$UserRole.DeveloperName}&reportType=REPAIR">Print Summary</apex:outputLink>
        <br/>
        <br/>
    </apex:outputPanel>
    
    <!-- START OF THE FORM -->
    <apex:form id="srForm" rendered="{! $ObjectType.Case.accessible}" >
        <!-- ACTION FUNCTION DEFINITIONS; INVOKED FROM WITHIN THE JAVASCRIPT ABOVE -->
        <apex:actionFunction name="updateProduct" action="{! updatePicklistsFromProductId}" reRender="serializedFieldcMode,softVersionField,pnlResMedProduct,productInput,productNameField,problemCodePicklist,pbHeaderInfo,pnlProductCategoryList,pnlProductModel,pnlSerialized,serialNumberField,lotNumberField,productSearchlinkId,patientSection" status="productNameStatus" focus="productInput" immediate="true">
            <apex:param name="selectedProductId" value=""/>
            <apex:param name="selectedProductCode" value=""/>
        </apex:actionFunction>
        <apex:actionFunction name="setStatus" action="{! setStatus}" reRender="" immediate="true"/>
        <apex:actionFunction name="updateProductFromProductCode" action="{! updatePicklistsFromProductCode}" reRender="serializedFieldcMode,softVersionField,pnlResMedProduct,productInput,productNameField,problemCodePicklist,pbHeaderInfo,pnlProductCategoryList,pnlProductModel,pnlSerialized,serialNumberField,lotNumberField,productSearchlinkId,patientSection" status="productNameStatus" focus="productInput" immediate="true" oncomplete="updateProductFromProductCodeCallback('{! selectedFamily}','{! selectedModel}');">
            <apex:param name="selectedProductCode" value=""/>
        </apex:actionFunction>
        <apex:actionFunction name="wipeProduct" action="{! flushProduct}" reRender="serializedFieldcMode,softVersionField,pnlResMedProduct,productInput,productNameField,problemCodePicklist,pbHeaderInfo,pnlProductCategoryList,pnlProductModel,pnlSerialized,serialNumberField,lotNumberField,productSearchlinkId" immediate="true"/>
        <apex:actionFunction name="updateSpareParts" action="{! updateSparePartsList}" rerender="pbSpareParts,pbProduct" immediate="true">
            <apex:param name="selectedProductId" value=""/>
        </apex:actionFunction>
        <apex:actionFunction name="removeSparePart" action="{! removeSparePart}" rerender="pbSpareParts,pbProduct" immediate="true">
            <apex:param name="selectedProductId" value=""/>
        </apex:actionFunction>
        <apex:actionFunction name="questionsLookedAt" action="{! questionsLookedAt}" reRender="productSearchlinkId" immediate="true"/>
        <apex:actionFunction name="problemCodeSelected" action="{! problemCodeSelected}" reRender="adverseEventOccurredPicklist,pbQuestions" immediate="true">
            <apex:param name="selectedProblemCode" value=""/>
        </apex:actionFunction>
        
        <apex:pageBlock >
            <center>
                <apex:pageBlockButtons location="top">
                    <apex:commandButton status="saveStatus" action="{! editSR}" value="{!$Label.Edit}" rendered="{! (not editMode) && (not createMode)}" reRender="srForm, pbHeaderInfo" disabled="{! Case.Status == 'Cancelled by Customer' || Case.Status == 'Cancelled - Raised in Error' || Case.Status == 'Closed'}" oncomplete="updateProductFromProductCodeCallback('{! selectedFamily}','{! selectedModel}');"/>
                    <apex:actionFunction name="sendToApex" action="{!saveSR}" rerender="srForm, pbHeaderInfo, capeQA">
                        <apex:param name="questionResponseData" value="" assignTo="{!questionResponseJSON}"/>
                    </apex:actionFunction>
                    <!--EUTSV-3344, SAVE Disable and family picklist issue, added Id into the Save button
EUTSV-3752, Incorrect Escalate to QA - Mislabel-->
                    <apex:commandButton id="saveBtn" status="saveStatus" onclick="var btn = document.getElementById('{!$Component.saveBtn}'); if(btn){btn.disabled = true; btn.style.opacity = 0.5; btn.style.pointerEvents = 'none';} setTimeout(function() {fetchQuestionAndResponse();}, 2000); return false;" value="{!$Label.Save}" rendered="{! editMode || createMode}" oncomplete="updateProductFromProductCodeCallback('{! selectedFamily}','{! selectedModel}');"/>  
                    <apex:commandButton action="{! cancelUpdate}" status="saveStatus" value="Cancel" rendered="{! editMode || createMode}" immediate="true">
                        <apex:param name="editMode" value="false" />
                        <apex:param name="createMode" value="false" />
                    </apex:commandButton>
                    <br/>
                    <apex:actionStatus id="saveStatus">
                        <apex:facet name="start">
                            <apex:image url="{! URLFOR($Resource.progbar200x22)}" alt=" working..." height="13px" width="100px"/>
                        </apex:facet>
                    </apex:actionStatus>
                </apex:pageBlockButtons>
            </center>
            <apex:messages styleClass="messageClass" />
            <apex:pageBlockSection id="pbServiceRequestNotAccessible" title="Details" rendered="{! not $ObjectType.Case.accessible}">
                <p><apex:outputText value="{!$Label.NoAccessToCaseLabel}"/></p>
            </apex:pageBlockSection>
            <apex:pageBlockSection id="pbHeaderInfo" title="Header Info" rendered="{! id!=null && $ObjectType.Case.accessible}">
                <apex:pageBlockSectionItem />
                <apex:pageBlockSectionItem />
                <apex:outputField value="{! Case.Account.Name}"/>
