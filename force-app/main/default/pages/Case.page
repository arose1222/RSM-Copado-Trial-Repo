                           tabClass="activeTab"
                           inactiveTabClass="inactiveTab">
                
                <apex:tab id="tabAccount" label="Account" name="Account">
                    <apex:pageBlock title="Account Information" id="pbAccount">
                        <apex:pageBlockSection rendered="{! not editMode && not createMode}">
                            <apex:outputField value="{! Case.AccountId}"/>
                            <apex:outputText >&nbsp;</apex:outputText>
                            <apex:outputField value="{! Case.Device_Contact__c}"/>
                            <apex:outputText >&nbsp;</apex:outputText>
                        </apex:pageBlockSection>
                        <apex:pageBlockSection rendered="{! editMode || createMode}">
                            <apex:inputField value="{! Case.AccountId}" required="true"/>
                            <apex:outputText >&nbsp;</apex:outputText>
                            <apex:inputField value="{! Case.Device_Contact__c}" required="true"/>
                            <apex:outputText >&nbsp;</apex:outputText>
                            <apex:inputField value="{! Case.Contact_Notes__c}" styleClass="textClass" required="false"/>
