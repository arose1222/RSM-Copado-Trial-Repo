                <apex:outputField value="{! Case.Repaired_By__c}"/>
                
                <apex:pageBlockSectionItem />
                <apex:pageBlockSectionItem />
                <apex:pageBlockSectionItem />
                <apex:pageBlockSectionItem />
            </apex:pageBlockSection>
            <!-- TAB PANEL SECTION -->
            <apex:tabPanel id="tpServiceRequest"
                           switchType="client"
                           selectedTab="Account"
                           headerSpacing="1"
